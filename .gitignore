# Local Netlify folder
.netlify

# Dependencies
node_modules/

# Fichiers système macOS
.DS_Store

# Secrets PHP (jamais versionnés — voir php/secrets.example.php)
php/secrets.php

# Données réelles du back office (code admin, contenu édité en prod) —
# jamais versionnées : elles n'existent que sur le serveur de déploiement.
php/data/credentials.json
php/data/instagram-token.json

# Base de données SQLite du sous-projet "Sylvain site" (projets-web/sylvain-site) —
# fichier généré automatiquement au premier accès depuis data/schema.sqlite.sql
# (qui reste versionné). Contient des données de test/exécution, jamais commitées.
projets-web/sylvain-site/data/*.sqlite
